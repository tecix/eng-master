{
  "id": "io.github.tecix.eng_master",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "enmaster",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/enmaster/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "enmaster",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --locked",
        "install -Dm755 target/release/enmaster -t /app/bin/",
        "install -Dm644 data/io.github.tecix.eng_master.desktop -t /app/share/applications/",
        "install -Dm644 data/io.github.tecix.eng_master.service -t /app/share/dbus-1/services/",
        "install -Dm644 data/io.github.tecix.eng_master.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.tecix.eng_master.svg -t /app/share/icons/hicolor/scalable/apps/",
        "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.tecix.eng_master-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps/",
        "for lang in $(grep -v '^#' po/LINGUAS); do install -d /app/share/locale/$lang/LC_MESSAGES; msgfmt -o /app/share/locale/$lang/LC_MESSAGES/enmaster.mo po/$lang.po; done"
      ],
      "sources": [
        { "type": "dir", "path": ".." },
        "cargo-sources.json"
      ]
    }
  ]
}
